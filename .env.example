# Copy to .env and adjust. The server validates all of these at startup.

# Required. At least 32 bytes; use a random value per environment.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# Token lifetime. Default 1h.
JWT_TTL=1h

# HTTP
PORT=8080
SPA_DIR=

# Database: DATABASE_URL wins; otherwise the DB_* parts are combined.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=scaleco
DB_SSLMODE=disable

# Connection pool
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Apply migrations at startup (set false when running migrations as a job).
MIGRATE_ON_BOOT=true

# Seed the demo workspace/accounts through the API at startup. Set false for a
# clean production deployment.
SEED_DEMO=true
